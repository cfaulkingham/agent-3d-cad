set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
# file(GLOB_RECURSE ... RELATIVE) requires an absolute base, even when the
# caller supplies a relative --prefix to cmake --install.
get_filename_component(root "${root}" ABSOLUTE)
if(POLICY CMP0207)
  cmake_policy(SET CMP0207 NEW)
endif()
set(executable "${root}/bin/agent-3d-cad@CMAKE_EXECUTABLE_SUFFIX@")
set(notices "@AGENTCAD_NOTICE_DIRECTORY@")
foreach(required occt/LICENSE_LGPL_21.txt occt/OCCT_LGPL_EXCEPTION.txt
    occt/PatchOcctHlr.cmake occt/OCCT-HLR-PATCH.md
    occt/agentcad-hlr-midpoint-v2.json
    occt/modified/HLRBRep_Intersector.cxx occt/modified/HLRBRep_Intersector.hxx
    occt/modified/HLRBRep_Data.cxx occt/modified/HLRBRep_Data.hxx occt/modified/HLRBRep_Hider.cxx
    freetype/LICENSE.TXT freetype/FTL.TXT freetype/GPLv2.TXT
    freetype/embedded/src/bdf/README freetype/embedded/src/pcf/README
    freetype/embedded/src/base/fthash.c freetype/embedded/include/freetype/internal/fthash.h
    freetype/embedded/src/gzip/zlib.h freetype/embedded/src/autofit/ft-hb-ft.c
    freetype/embedded/src/autofit/ft-hb-decls.h freetype/embedded/src/autofit/ft-hb-types.h
    freetype/embedded/src/autofit/hb-script-list.h)
  if(NOT EXISTS "${notices}/${required}")
    message(FATAL_ERROR "Missing ${required}. Build the pinned dependency recipe, or set AGENTCAD_NOTICE_DIRECTORY to its complete notice tree. A partial bundle is not distributable.")
  endif()
endforeach()
file(READ "${notices}/occt/agentcad-hlr-midpoint-v2.json" hlr_metadata)
string(JSON hlr_format ERROR_VARIABLE hlr_format_error GET "${hlr_metadata}" format_version)
string(JSON hlr_version ERROR_VARIABLE hlr_version_error GET "${hlr_metadata}" occt_version)
string(JSON hlr_modification ERROR_VARIABLE hlr_modification_error GET "${hlr_metadata}" modification)
string(JSON hlr_count ERROR_VARIABLE hlr_count_error LENGTH "${hlr_metadata}" binaries)
if(hlr_format_error OR hlr_version_error OR hlr_modification_error OR hlr_count_error
    OR NOT hlr_format STREQUAL "1" OR NOT hlr_version STREQUAL "8.0.1"
    OR NOT hlr_modification STREQUAL "agentcad-hlr-midpoint-v2" OR hlr_count LESS 1)
  message(FATAL_ERROR "Invalid OCCT HLR SDK modification manifest. Rebuild the pinned dependency recipe and use its matching notices.")
endif()
file(SHA256 "$<TARGET_FILE:TKHLR>" selected_hlr_hash)
set(hlr_verified FALSE)
math(EXPR hlr_last "${hlr_count}-1")
foreach(index RANGE 0 ${hlr_last})
  string(JSON recorded_hash ERROR_VARIABLE recorded_hash_error GET "${hlr_metadata}" binaries ${index} sha256)
  if(NOT recorded_hash_error AND recorded_hash STREQUAL selected_hlr_hash)
    set(hlr_verified TRUE)
  endif()
endforeach()
if(NOT hlr_verified)
  message(FATAL_ERROR "Selected TKHLR ($<TARGET_FILE:TKHLR>) does not match the patched SDK manifest. Unmodified SDKs remain supported for developer builds; portable bundles require the pinned dependency recipe and its matching notices.")
endif()
if(NOT EXISTS "@AGENTCAD_JSON_LICENSE@")
  message(FATAL_ERROR "Set AGENTCAD_JSON_LICENSE to the exact nlohmann JSON 3.12.0 LICENSE.MIT")
endif()
file(INSTALL "${notices}/" DESTINATION "${root}/share/agent-3d-cad/notices" TYPE DIRECTORY)
file(INSTALL "@AGENTCAD_JSON_LICENSE@" DESTINATION "${root}/share/agent-3d-cad/notices/nlohmann-json" TYPE FILE)
foreach(extra IN ITEMS @AGENTCAD_EXTRA_NOTICE_FILES@)
  file(INSTALL "${extra}" DESTINATION "${root}/share/agent-3d-cad/notices/extra" TYPE FILE)
endforeach()

set(search_dirs "${root}/bin" "@OpenCASCADE_LIBRARY_DIR@" "@OpenCASCADE_BINARY_DIR@")
get_filename_component(ft_dir "@FREETYPE_LIBRARY_RELEASE@" DIRECTORY)
list(APPEND search_dirs "${ft_dir}")
if("@WIN32@")
  set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@AGENTCAD_DUMPBIN@")
  set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
  set(native_dir "${root}/bin")
  set(pre_excludes "api-ms-.*" "ext-ms-.*")
  include("@CMAKE_CURRENT_SOURCE_DIR@/cmake/WindowsRuntimeFilters.cmake")
  set(post_excludes "${AGENTCAD_WINDOWS_SYSTEM_DLL_REGEX}")
elseif("@APPLE@")
  set(native_dir "${root}/lib")
  set(post_excludes "^/System/Library/" "^/usr/lib/")
else()
  set(native_dir "${root}/lib")
  # libc and its loader are the platform ABI; ship the remaining runtime closure,
  # including libstdc++ and libgcc, so a compiler is never a target prerequisite.
  set(pre_excludes "^linux-vdso" "^ld-linux" "^lib(c|m|pthread|dl|rt|resolv)\\.so")
  # Fontconfig's distro installation references the same FreeType SONAME as
  # the selected SDK. CMake scans each branch independently, unlike the ELF
  # loader's already-loaded SONAME table. Keep exactly the configured FreeType
  # and avoid traversing an unused system copy's optional integrations.
  set(selected_freetype "@FREETYPE_LIBRARY_RELEASE@")
  if(EXISTS "${selected_freetype}")
    list(APPEND post_includes "${selected_freetype}")
    list(APPEND post_excludes "/libfreetype\\.so")
  endif()
endif()
# Inspect the build executable, whose SDK RPATHs can resolve the full closure.
# The installed executable already has relative RPATHs, before lib/ is populated.
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "$<TARGET_FILE:agent-3d-cad>"
  RESOLVED_DEPENDENCIES_VAR libraries UNRESOLVED_DEPENDENCIES_VAR unresolved
  CONFLICTING_DEPENDENCIES_PREFIX conflicts DIRECTORIES ${search_dirs}
  PRE_EXCLUDE_REGEXES ${pre_excludes} POST_EXCLUDE_REGEXES ${post_excludes}
  POST_INCLUDE_FILES ${post_includes})
if(unresolved OR conflicts_FILENAMES)
  message(FATAL_ERROR "Runtime dependencies unresolved: ${unresolved}; conflicting names: ${conflicts_FILENAMES}")
endif()
if(DEFINED selected_freetype AND EXISTS "${selected_freetype}")
  file(REAL_PATH "${selected_freetype}" selected_freetype_real)
  set(found_selected_freetype FALSE)
  foreach(library IN LISTS libraries)
    file(REAL_PATH "${library}" library_real)
    if(library_real STREQUAL selected_freetype_real)
      set(found_selected_freetype TRUE)
    endif()
  endforeach()
  if(NOT found_selected_freetype)
    message(FATAL_ERROR "The executable dependency closure does not contain the selected FreeType: ${selected_freetype}")
  endif()
endif()
if(NOT "@WIN32@" AND "@AGENTCAD_EXTRA_NOTICE_FILES@" STREQUAL "")
  foreach(library IN LISTS libraries)
    get_filename_component(name "${library}" NAME)
    if(NOT name MATCHES "^lib(TK|freetype)")
      message(FATAL_ERROR "Bundling ${name} requires its exact notices in AGENTCAD_EXTRA_NOTICE_FILES. The pinned OCCT/FreeType notices cover only those two dependencies.")
    endif()
  endforeach()
endif()
file(MAKE_DIRECTORY "${native_dir}")
set(installed_libraries)
foreach(library IN LISTS libraries)
  get_filename_component(name "${library}" NAME)
  # Copy through symlinks, retaining the exact loader-requested filename.
  file(INSTALL "${library}" DESTINATION "${native_dir}" TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN)
  list(APPEND installed_libraries "${native_dir}/${name}")
endforeach()
if("@APPLE@")
  find_program(install_name_tool install_name_tool REQUIRED)
  find_program(otool otool REQUIRED)
  find_program(codesign codesign REQUIRED)
  foreach(binary IN ITEMS "${executable}" ${installed_libraries})
    execute_process(COMMAND "${otool}" -L "${binary}" OUTPUT_VARIABLE linked COMMAND_ERROR_IS_FATAL ANY)
    foreach(original IN LISTS libraries)
      get_filename_component(name "${original}" NAME)
      # Dependencies can use an absolute install name or a pre-existing @rpath.
      string(REGEX MATCHALL "[^\n\t ]+/${name} " matches "${linked}")
      foreach(match IN LISTS matches)
        string(STRIP "${match}" old)
        execute_process(COMMAND "${install_name_tool}" -change "${old}" "@executable_path/../lib/${name}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
      endforeach()
    endforeach()
    if(NOT binary STREQUAL executable)
      get_filename_component(name "${binary}" NAME)
      execute_process(COMMAND "${install_name_tool}" -id "@rpath/${name}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    execute_process(COMMAND "${otool}" -l "${binary}" OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
    if(commands MATCHES "minos ([0-9.]+)")
      set(binary_minimum_macos "${CMAKE_MATCH_1}")
      if(NOT DEFINED minimum_macos OR binary_minimum_macos VERSION_GREATER minimum_macos)
        set(minimum_macos "${binary_minimum_macos}")
      endif()
    endif()
    string(REGEX MATCHALL "path /[^\n]+ \\(offset [0-9]+\\)" rpaths "${commands}")
    foreach(rpath IN LISTS rpaths)
      string(REGEX REPLACE "^path (.+) \\(offset [0-9]+\\)$" "\\1" absolute "${rpath}")
      execute_process(COMMAND "${install_name_tool}" -delete_rpath "${absolute}" "${binary}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
    # Modifying load commands invalidates the linker signature on Apple silicon.
    # This ad-hoc signature is for local execution, not release notarization.
    execute_process(COMMAND "${codesign}" --force --sign - "${binary}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${otool}" -L "${binary}" OUTPUT_VARIABLE verified COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" lines "${verified}")
    foreach(line IN LISTS lines)
      if(line MATCHES "^[\t ]+(/[^ ]+)")
        if(NOT CMAKE_MATCH_1 MATCHES "^(/usr/lib/|/System/Library/)")
          message(FATAL_ERROR "Nonportable library path remains in ${binary}: ${line}")
        endif()
      endif()
    endforeach()
  endforeach()
elseif(NOT "@WIN32@")
  if(NOT EXISTS "@AGENTCAD_PATCHELF@")
    message(FATAL_ERROR "Portable Linux bundles require patchelf on the build machine")
  endif()
  foreach(library IN LISTS installed_libraries)
    execute_process(COMMAND "@AGENTCAD_PATCHELF@" --set-rpath "$ORIGIN" "${library}" COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  execute_process(COMMAND "@AGENTCAD_PATCHELF@" --set-rpath "$ORIGIN/../lib" "${executable}" COMMAND_ERROR_IS_FATAL ANY)
  foreach(binary IN ITEMS "${executable}" ${installed_libraries})
    execute_process(COMMAND "@AGENTCAD_PATCHELF@" --print-needed "${binary}"
      OUTPUT_VARIABLE needed COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" needed "${needed}")
    foreach(dependency IN LISTS needed)
      if(dependency MATCHES "/")
        message(FATAL_ERROR "Nonportable DT_NEEDED path remains in ${binary}: ${dependency}. Rebuild this dependency with a relative SONAME.")
      endif()
    endforeach()
  endforeach()
endif()

execute_process(COMMAND "${executable}" tools
  OUTPUT_FILE "${root}/share/agent-3d-cad/tools.json"
  ERROR_VARIABLE schema_diagnostics RESULT_VARIABLE schema_status)
if(NOT schema_status EQUAL 0)
  message(FATAL_ERROR "Installed executable could not publish tool schemas: ${schema_diagnostics}")
endif()

set(manifest "{\n  \"format_version\": 1,\n  \"project_version\": \"@AGENTCAD_VERSION@\",\n  \"system\": \"@CMAKE_SYSTEM_NAME@\",\n  \"architecture\": \"@CMAKE_SYSTEM_PROCESSOR@\",\n  \"compiler\": \"@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\",\n  \"occt_version\": \"8.0.1\",\n  \"occt_archive_sha256\": \"0d6913eae4bcc09a3653ceced6dda1aec11c35a1513d4c06762c9b002092c68a\",\n  \"json_version\": \"3.12.0\",\n  \"json_archive_sha256\": \"4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187\",\n  \"freetype_version\": \"@FREETYPE_VERSION_STRING@\",\n  \"original_code_license\": \"MIT\",\n  \"files\": [")
file(GLOB_RECURSE packaged_files RELATIVE "${root}" "${root}/bin/*" "${root}/lib/*" "${root}/share/*")
list(REMOVE_ITEM packaged_files "share/agent-3d-cad/provenance.json")
if(NOT packaged_files)
  message(FATAL_ERROR "Cannot publish a bundle with empty file provenance")
endif()
set(separator "")
foreach(file IN LISTS packaged_files)
  if(NOT IS_DIRECTORY "${root}/${file}")
    file(SHA256 "${root}/${file}" hash)
    string(APPEND manifest "${separator}\n    {\"path\": \"${file}\", \"sha256\": \"${hash}\"}")
    set(separator ",")
  endif()
endforeach()
string(APPEND manifest "\n  ]\n}\n")
string(JSON manifest SET "${manifest}" occt_linkage "\"@AGENTCAD_OCCT_LINKAGE@\"")
string(JSON manifest SET "${manifest}" occt_modifications "[\"${hlr_modification}\"]")
string(JSON manifest SET "${manifest}" occt_hlr_sdk_sha256 "\"${selected_hlr_hash}\"")
string(JSON manifest SET "${manifest}" freetype_recipe_archive_sha256 "\"36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f\"")
string(JSON manifest SET "${manifest}" viewer_app_sha256 "\"@AGENTCAD_APP_SHA256@\"")
if(DEFINED minimum_macos)
  string(JSON manifest SET "${manifest}" minimum_macos "\"${minimum_macos}\"")
endif()
file(WRITE "${root}/share/agent-3d-cad/provenance.json" "${manifest}")
