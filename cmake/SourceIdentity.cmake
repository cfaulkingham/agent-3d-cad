# Portable production-input identity. No Git metadata, timestamps or host paths.
function(agentcad_source_manifest source_root output)
  # Only a configure caller may opt into generator dependency tracking. CPack
  # embeds the install interpreter without reliably setting CMAKE_SCRIPT_MODE_FILE.
  cmake_parse_arguments(identity "TRACK_CONFIGURE" "" "" ${ARGN})
  if(identity_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown source identity option: ${identity_UNPARSED_ARGUMENTS}")
  endif()
  get_filename_component(source_root "${source_root}" ABSOLUTE)
  set(patterns)
  foreach(directory src include web third_party cmake)
    list(APPEND patterns "${source_root}/${directory}/*")
  endforeach()
  if(identity_TRACK_CONFIGURE)
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE ${patterns})
  else()
    file(GLOB_RECURSE sources LIST_DIRECTORIES FALSE ${patterns})
  endif()
  list(APPEND sources "${source_root}/CMakeLists.txt" "${source_root}/VERSION")
  list(REMOVE_DUPLICATES sources)
  list(SORT sources)
  set(manifest "")
  foreach(source IN LISTS sources)
    if(NOT EXISTS "${source}" OR IS_SYMLINK "${source}")
      message(FATAL_ERROR "Source identity requires regular production inputs: ${source}")
    endif()
    file(RELATIVE_PATH relative "${source_root}" "${source}")
    if(relative MATCHES "[\r\n]" OR relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Unsafe source identity path")
    endif()
    file(SHA256 "${source}" digest)
    string(APPEND manifest "${digest}  ${relative}\n")
    if(identity_TRACK_CONFIGURE)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    endif()
  endforeach()
  set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

# The manifest hash names its exact bytes on every host. file(WRITE) uses
# native text newlines on Windows, which differ from the in-memory LF string.
function(agentcad_write_source_manifest output content)
  # Substitute once so @...@ and ${...} in input filenames stay literal.
  # CONFIGURE terminates its template line; avoid adding a second final LF.
  string(REGEX REPLACE "\n$" "" content "${content}")
  file(CONFIGURE OUTPUT "${output}" CONTENT [[@content@]] @ONLY NEWLINE_STYLE LF)
endfunction()

# Shared install-time verification; deliberately independent of Git state.
function(agentcad_verify_source_stamp source_root input_manifest expected_source stamp_file executable output)
  agentcad_source_manifest("${source_root}" current_source)
  file(READ "${input_manifest}" configured_source)
  if(NOT current_source STREQUAL configured_source)
    message(FATAL_ERROR "Production source changed after configure/build; rebuild before packaging")
  endif()
  file(SHA256 "${input_manifest}" source_hash)
  if(NOT source_hash STREQUAL expected_source)
    message(FATAL_ERROR "Source manifest differs from configured identity")
  endif()
  file(READ "${stamp_file}" build_identity)
  string(JSON built_source GET "${build_identity}" source_sha256)
  string(JSON built_executable GET "${build_identity}" executable_sha256)
  file(SHA256 "${executable}" actual_executable)
  if(NOT built_source STREQUAL source_hash OR NOT built_executable STREQUAL actual_executable)
    message(FATAL_ERROR "Native executable differs from its successful build/source stamp; rebuild before packaging")
  endif()
  set(${output} "${build_identity}" PARENT_SCOPE)
endfunction()

# Developer/CI inspection entrypoint; the exact same function stamps the build.
if(CMAKE_SCRIPT_MODE_FILE AND DEFINED OUTPUT_MANIFEST)
  if(NOT DEFINED SOURCE_ROOT OR NOT IS_DIRECTORY "${SOURCE_ROOT}")
    message(FATAL_ERROR "SOURCE_ROOT must name the production checkout")
  endif()
  agentcad_source_manifest("${SOURCE_ROOT}" source_manifest)
  agentcad_write_source_manifest("${OUTPUT_MANIFEST}" "${source_manifest}")
endif()
