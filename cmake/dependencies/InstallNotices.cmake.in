set(destination "@AGENTCAD_DEPS_PREFIX@/share/agentcad-dependency-notices")
file(MAKE_DIRECTORY "${destination}/occt")
file(COPY "@occt_source@/LICENSE_LGPL_21.txt" "@occt_source@/OCCT_LGPL_EXCEPTION.txt" DESTINATION "${destination}/occt")
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/PatchOcctHlr.cmake" "@CMAKE_CURRENT_SOURCE_DIR@/OCCT-HLR-PATCH.md" DESTINATION "${destination}/occt")
file(MAKE_DIRECTORY "${destination}/occt/modified")
foreach(source HLRBRep_Intersector.cxx HLRBRep_Intersector.hxx HLRBRep_Data.cxx HLRBRep_Data.hxx HLRBRep_Hider.cxx)
  file(COPY "@occt_source@/src/ModelingAlgorithms/TKHLR/HLRBRep/${source}" DESTINATION "${destination}/occt/modified")
endforeach()
# Bind the source modification to the actual SDK libraries. Portable packaging
# verifies its selected TKHLR before claiming this modification in provenance.
file(GLOB hlr_libraries
  "@AGENTCAD_DEPS_PREFIX@/lib/libTKHLR*.dylib"
  "@AGENTCAD_DEPS_PREFIX@/lib/libTKHLR*.so*"
  "@AGENTCAD_DEPS_PREFIX@/bin/TKHLR*.dll")
set(hlr_metadata "{\"format_version\":1,\"occt_version\":\"8.0.1\",\"modification\":\"agentcad-hlr-midpoint-v1\",\"binaries\":[]}")
set(hlr_count 0)
foreach(library IN LISTS hlr_libraries)
  if(IS_SYMLINK "${library}" OR IS_DIRECTORY "${library}")
    continue()
  endif()
  file(SHA256 "${library}" library_hash)
  file(RELATIVE_PATH library_path "@AGENTCAD_DEPS_PREFIX@" "${library}")
  set(record "{}")
  string(JSON record SET "${record}" path "\"${library_path}\"")
  string(JSON record SET "${record}" sha256 "\"${library_hash}\"")
  string(JSON hlr_metadata SET "${hlr_metadata}" binaries ${hlr_count} "${record}")
  math(EXPR hlr_count "${hlr_count}+1")
endforeach()
if(hlr_count EQUAL 0)
  message(FATAL_ERROR "Cannot record the OCCT HLR modification: no installed TKHLR shared library found in @AGENTCAD_DEPS_PREFIX@")
endif()
file(WRITE "${destination}/occt/agentcad-hlr-midpoint-v1.json" "${hlr_metadata}\n")
if(NOT "@AGENTCAD_SYSTEM_FREETYPE@")
  file(MAKE_DIRECTORY "${destination}/freetype")
  file(COPY "@ft_source@/LICENSE.TXT" "@ft_source@/docs/FTL.TXT" "@ft_source@/docs/GPLv2.TXT" DESTINATION "${destination}/freetype")
  # LICENSE.TXT explicitly names these embedded components. Preserve the exact
  # upstream notice-bearing files, including built-in zlib (disabling external
  # zlib linkage does not disable FreeType's embedded gzip implementation).
  foreach(notice IN ITEMS src/bdf/README src/pcf/README src/base/fthash.c
      include/freetype/internal/fthash.h src/gzip/zlib.h
      src/autofit/ft-hb-ft.c src/autofit/ft-hb-decls.h
      src/autofit/ft-hb-types.h src/autofit/hb-script-list.h)
    get_filename_component(subdirectory "${notice}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination}/freetype/embedded/${subdirectory}")
    file(COPY "@ft_source@/${notice}" DESTINATION "${destination}/freetype/embedded/${subdirectory}")
  endforeach()
endif()
