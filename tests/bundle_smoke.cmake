cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED BUILD_DIR OR NOT DEFINED TEST_DIR)
  message(FATAL_ERROR "BUILD_DIR and TEST_DIR are required")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(TEST_DIR "${TEST_DIR}" ABSOLUTE)
file(REMOVE_RECURSE "${TEST_DIR}")
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config Release --prefix staging
  WORKING_DIRECTORY "${TEST_DIR}"
  RESULT_VARIABLE status OUTPUT_VARIABLE installed ERROR_VARIABLE diagnostics)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Bundle install failed: ${installed}\n${diagnostics}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DBUNDLE_DIR=${TEST_DIR}/staging"
  "-DINSTALL_DIR=${TEST_DIR}/relocated bundles" "-DRESULT_FILE=${TEST_DIR}/install-result.json"
  -P "${CMAKE_CURRENT_LIST_DIR}/../packaging/install-local.cmake"
  RESULT_VARIABLE status OUTPUT_VARIABLE installed ERROR_VARIABLE diagnostics)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Verified local installation failed: ${installed}\n${diagnostics}")
endif()
file(READ "${TEST_DIR}/install-result.json" installation)
string(JSON bundle GET "${installation}" install_dir)
if(WIN32)
  set(suffix .exe)
endif()
set(CAD_EXE "${bundle}/bin/agent-3d-cad${suffix}")
set(SOURCE_DIR "${bundle}/share/agent-3d-cad")
if(NOT EXISTS "${SOURCE_DIR}/skills/native-cad/SKILL.md")
  message(FATAL_ERROR "Bundle is missing its native CAD workflow skill")
endif()
file(READ "${SOURCE_DIR}/provenance.json" provenance)
string(JSON hlr_patch GET "${provenance}" occt_modifications 0)
if(NOT hlr_patch STREQUAL "agentcad-hlr-midpoint-v2")
  message(FATAL_ERROR "Bundle must identify its reproducible OCCT midpoint optimization")
endif()
file(READ "${SOURCE_DIR}/notices/occt/agentcad-hlr-midpoint-v2.json" hlr_metadata)
string(JSON hlr_metadata_patch GET "${hlr_metadata}" modification)
string(JSON hlr_metadata_version GET "${hlr_metadata}" occt_version)
string(JSON hlr_metadata_format GET "${hlr_metadata}" format_version)
string(JSON hlr_sdk_hash GET "${provenance}" occt_hlr_sdk_sha256)
string(JSON hlr_binary_count LENGTH "${hlr_metadata}" binaries)
if(NOT hlr_metadata_patch STREQUAL hlr_patch OR NOT hlr_metadata_version STREQUAL "8.0.1"
    OR NOT hlr_metadata_format EQUAL 1 OR hlr_binary_count LESS 1)
  message(FATAL_ERROR "Bundle OCCT modification metadata is inconsistent")
endif()
set(hlr_sdk_recorded FALSE)
math(EXPR hlr_binary_last "${hlr_binary_count}-1")
foreach(index RANGE 0 ${hlr_binary_last})
  string(JSON recorded_hash GET "${hlr_metadata}" binaries ${index} sha256)
  if(recorded_hash STREQUAL hlr_sdk_hash)
    set(hlr_sdk_recorded TRUE)
  endif()
endforeach()
if(NOT hlr_sdk_recorded)
  message(FATAL_ERROR "Bundle provenance does not identify a binary from its patched SDK manifest")
endif()
foreach(source HLRBRep_Intersector.cxx HLRBRep_Intersector.hxx HLRBRep_Data.cxx HLRBRep_Data.hxx HLRBRep_Hider.cxx)
  if(NOT EXISTS "${SOURCE_DIR}/notices/occt/modified/${source}")
    message(FATAL_ERROR "Bundle is missing modified OCCT source: ${source}")
  endif()
endforeach()
if(NOT EXISTS "${SOURCE_DIR}/ARTIFACT_REVIEW.md")
  message(FATAL_ERROR "Bundle omitted external-artifact review guidance")
endif()
file(READ "${SOURCE_DIR}/notices/tinyxml2/PROVENANCE.json" artifact_dependencies)
string(JSON tinyxml2_version GET "${provenance}" tinyxml2_version)
string(JSON tinyxml2_archive GET "${provenance}" tinyxml2_archive_sha256)
string(JSON tinyxml2_linkage GET "${provenance}" tinyxml2_linkage)
if(NOT tinyxml2_version STREQUAL "11.0.0" OR NOT tinyxml2_archive STREQUAL "5556deb5081fb246ee92afae73efd943c889cef0cafea92b0b82422d6a18f289"
    OR NOT tinyxml2_linkage STREQUAL "statically compiled into cad_core")
  message(FATAL_ERROR "Bundle omitted pinned TinyXML2 provenance")
endif()
foreach(source tinyxml2.cpp tinyxml2.h LICENSE.txt readme.md)
  string(JSON expected_hash GET "${artifact_dependencies}" tinyxml2 files "${source}")
  string(JSON recorded_hash GET "${provenance}" tinyxml2_sources_sha256 "${source}")
  file(SHA256 "${SOURCE_DIR}/notices/tinyxml2/${source}" actual_hash)
  if(NOT actual_hash STREQUAL expected_hash OR NOT actual_hash STREQUAL recorded_hash)
    message(FATAL_ERROR "Bundled TinyXML2 source/notice differs from pin: ${source}")
  endif()
endforeach()
set(TEST_DIR "${TEST_DIR}/workflow")
# Absolute service paths and direct worker spawn must work without SDK tooling
# on PATH or loader environment overrides. Windows retains SystemRoot for APIs.
set(ENV{PATH} "")
foreach(variable LD_LIBRARY_PATH DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH CASROOT CSF_SHMessage CSF_XSMessage CSF_STEPDefaults CSF_IGESDefaults CSF_StandardDefaults CSF_PluginDefaults CSF_XCAFDefaults)
  unset(ENV{${variable}})
endforeach()
execute_process(COMMAND "${CAD_EXE}" --version RESULT_VARIABLE status OUTPUT_VARIABLE version ERROR_VARIABLE logs)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Relocated bundle cannot start: ${logs}")
endif()
string(JSON kernel GET "${version}" kernel_version)
if(NOT kernel STREQUAL "8.0.1")
  message(FATAL_ERROR "Unexpected bundled kernel: ${kernel}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/cli_smoke.cmake")
call_tool(cad_drawing "${SOURCE_DIR}/examples/plate.drawing.json")
string(JSON drawing_manifest GET "${reply}" path)
string(JSON drawing_count LENGTH "${reply}" artifacts)
if(NOT EXISTS "${drawing_manifest}" OR NOT drawing_count EQUAL 6)
  message(FATAL_ERROR "Relocated native drawing did not publish PDF, SVG and four DXFs")
endif()
foreach(index RANGE 0 5)
  string(JSON drawing_file GET "${reply}" artifacts ${index} path)
  if(NOT EXISTS "${drawing_file}")
    message(FATAL_ERROR "Relocated drawing artifact missing: ${drawing_file}")
  endif()
endforeach()
call_tool(cad_drawing "${SOURCE_DIR}/examples/plate-section.drawing.json")
string(JSON section_layout GET "${reply}" layout)
string(JSON section_count LENGTH "${reply}" artifacts)
if(NOT section_layout STREQUAL "third_angle" OR NOT section_count EQUAL 6)
  message(FATAL_ERROR "Relocated section drawing did not preserve its standard layout and artifacts")
endif()
set(found_hatching FALSE)
foreach(index RANGE 0 5)
  string(JSON section_format GET "${reply}" artifacts ${index} format)
  if(section_format STREQUAL "svg")
    string(JSON section_file GET "${reply}" artifacts ${index} path)
    file(READ "${section_file}" section_svg)
    if(section_svg MATCHES "data-layer=\"HATCH\"")
      set(found_hatching TRUE)
    endif()
  endif()
endforeach()
if(NOT found_hatching)
  message(FATAL_ERROR "Relocated section drawing omitted requested material hatching")
endif()
call_tool(cad_create "${SOURCE_DIR}/examples/angular-plate.create.json")
call_tool(cad_drawing "${SOURCE_DIR}/examples/angular-plate.drawing.json")
string(JSON angle GET "${reply}" dimensions 0 value_deg)
string(JSON angle_lower GET "${reply}" dimensions 0 lower_limit_deg)
string(JSON angle_label GET "${reply}" dimensions 0 label)
string(JSON bore_lower GET "${reply}" dimensions 1 lower_limit_mm)
if(NOT angle EQUAL 45 OR NOT angle_lower EQUAL 44.75 OR
   NOT angle_label STREQUAL "45 +/-0.25 deg" OR NOT bore_lower EQUAL 7.98)
  message(FATAL_ERROR "Relocated drawing did not preserve angular dimensions and explicit tolerances")
endif()
file(GLOB cache_entries "${TEST_DIR}/workspace/.cache/*.json")
list(LENGTH cache_entries cache_count)
if(cache_count LESS 5)
  message(FATAL_ERROR "Relocated service did not cache exact geometry and projections")
endif()
set(cold_drawing "${reply}")
call_tool(cad_drawing "${SOURCE_DIR}/examples/angular-plate.drawing.json")
string(JSON artifact_count LENGTH "${reply}" artifacts)
math(EXPR last_artifact "${artifact_count}-1")
foreach(index RANGE 0 ${last_artifact})
  string(JSON cold_file GET "${cold_drawing}" artifacts ${index} path)
  string(JSON warm_file GET "${reply}" artifacts ${index} path)
  file(SHA256 "${cold_file}" cold_hash)
  file(SHA256 "${warm_file}" warm_hash)
  if(NOT cold_hash STREQUAL warm_hash)
    message(FATAL_ERROR "Cached relocated drawing changed artifact contents")
  endif()
endforeach()
call_tool(cad_create "${SOURCE_DIR}/examples/assembly.create.json")
string(JSON assembly_parts LENGTH "${reply}" summary assembly parts)
if(assembly_parts LESS 2)
  message(FATAL_ERROR "Relocated assembly omitted its editable part inventory")
endif()
string(JSON presented_document GET "${reply}" document_id)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" original_head_hash)
file(WRITE "${TEST_DIR}/presentation-open.json" "{\"document_id\":\"${presented_document}\",\"view_id\":\"bundle_presentation\"}")
call_tool(cad_open "${TEST_DIR}/presentation-open.json")
file(WRITE "${TEST_DIR}/presentation-sync.json" [=[{"action":"sync","view_id":"bundle_presentation"}]=])
foreach(attempt RANGE 0 199)
  call_tool(cad_viewer "${TEST_DIR}/presentation-sync.json")
  string(JSON presented_state GET "${reply}" state)
  if(presented_state STREQUAL "ready")
    break()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.01)
endforeach()
if(NOT presented_state STREQUAL "ready")
  message(FATAL_ERROR "Relocated live presentation did not become ready")
endif()
string(JSON presented_evaluation GET "${reply}" evaluation_id)
set(presentation_settings [=[{"clip":{"normal":[0,0,1],"offset_mm":3,"keep":"negative"},"explode":{"distance_mm":20,"directions":[]}}]=])
file(WRITE "${TEST_DIR}/presentation-save.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"presentation\":${presentation_settings}}")
call_tool(cad_viewer "${TEST_DIR}/presentation-save.json")
string(JSON expected_presentation GET "${reply}" presentation)
file(WRITE "${TEST_DIR}/presentation-read.json" [=[{"view_id":"bundle_presentation"}]=])
call_tool(cad_context "${TEST_DIR}/presentation-read.json")
string(JSON saved_presentation GET "${reply}" presentation)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" presented_head_hash)
if(NOT saved_presentation STREQUAL expected_presentation OR NOT original_head_hash STREQUAL presented_head_hash)
  message(FATAL_ERROR "Relocated presentation changed source HEAD or failed persistence across native processes")
endif()
# Annotations are persisted native review metadata, usable with an empty PATH.
file(WRITE "${TEST_DIR}/annotation-add.json" "{\"action\":\"annotation\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"operation\":\"add\",\"anchor\":{\"kind\":\"part\",\"part_id\":\"spacer_a\"},\"text\":\"Inspect source leaf clearance\"}")
call_tool(cad_viewer "${TEST_DIR}/annotation-add.json")
string(JSON annotation_id GET "${reply}" annotations 0 id)
string(JSON annotation_owner GET "${reply}" annotations 0 anchor part_id)
string(JSON annotation_status GET "${reply}" annotations 0 status)
string(JSON annotation_lifetime GET "${reply}" annotations 0 anchor_lifetime)
call_tool(cad_context "${TEST_DIR}/presentation-read.json")
string(JSON persisted_annotation GET "${reply}" annotations 0 id)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" annotation_head_hash)
if(NOT annotation_id STREQUAL persisted_annotation OR NOT annotation_owner STREQUAL "spacer_a" OR NOT annotation_status STREQUAL "current" OR NOT annotation_lifetime STREQUAL "evaluation" OR NOT original_head_hash STREQUAL annotation_head_hash)
  message(FATAL_ERROR "Relocated review note lost native source lifetime/ownership/persistence or changed HEAD")
endif()
file(WRITE "${TEST_DIR}/measurement.json" "{\"document_id\":\"${presented_document}\",\"revision\":1,\"evaluation_id\":\"${presented_evaluation}\",\"feature_id\":\"assembly\",\"query\":{\"action\":\"pair\",\"targets\":[{\"kind\":\"part\",\"part_id\":\"spacer_a\"},{\"kind\":\"part\",\"part_id\":\"spacer_b\"}],\"minimum_clearance_mm\":1}}")
call_tool(cad_measure "${TEST_DIR}/measurement.json")
string(JSON measured_distance GET "${reply}" report minimum_distance_mm)
string(JSON measured_status GET "${reply}" report status)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" measured_head_hash)
if(measured_distance LESS 31.231 OR measured_distance GREATER 31.232 OR NOT measured_status STREQUAL "pass" OR NOT original_head_hash STREQUAL measured_head_hash)
  message(FATAL_ERROR "Relocated exact measurement differs from analytic cylinder gap or changed source HEAD")
endif()
if(NOT EXISTS "${SOURCE_DIR}/SECTIONS.md")
  message(FATAL_ERROR "Relocated bundle omitted exact native section guidance")
endif()
file(WRITE "${TEST_DIR}/section.json" "{\"document_id\":\"${presented_document}\",\"revision\":1,\"evaluation_id\":\"${presented_evaluation}\",\"feature_id\":\"assembly\",\"query\":{\"action\":\"section\",\"plane\":{\"normal\":[0,0,1],\"offset_mm\":8}}}")
call_tool(cad_measure "${TEST_DIR}/section.json")
string(JSON section_area GET "${reply}" report area_mm2)
string(JSON section_regions LENGTH "${reply}" report regions)
string(JSON section_wires_a GET "${reply}" report regions 0 wire_count)
string(JSON section_wires_b GET "${reply}" report regions 1 wire_count)
string(JSON section_triangles LENGTH "${reply}" report mesh triangles)
string(JSON section_plane_z GET "${reply}" report mesh positions 0 2)
if(section_area LESS 117.8097 OR section_area GREATER 117.8098 OR NOT section_regions EQUAL 2 OR NOT section_wires_a EQUAL 2 OR NOT section_wires_b EQUAL 2 OR section_triangles LESS 1 OR NOT section_plane_z EQUAL 8)
  message(FATAL_ERROR "Relocated native section lost analytic annular areas, actual holes or cap-plane coordinates")
endif()
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" section_head_hash)
if(NOT original_head_hash STREQUAL section_head_hash)
  message(FATAL_ERROR "Relocated native section modified raw saved source")
endif()
# Exercise the independent live slot through fresh native processes. Core CAD
# and section jobs must work with no developer runtimes or tools on PATH.
set(section_presentation [=[{"clip":{"normal":[0,0,1],"offset_mm":8,"keep":"negative"},"explode":{"distance_mm":0,"directions":[]}}]=])
file(WRITE "${TEST_DIR}/section-context.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"presentation\":${section_presentation}}")
call_tool(cad_viewer "${TEST_DIR}/section-context.json")
file(WRITE "${TEST_DIR}/section-start.json" "{\"action\":\"section\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"query\":{\"action\":\"section\",\"plane\":{\"normal\":[0,0,1],\"offset_mm\":8}}}")
  call_tool(cad_viewer "${TEST_DIR}/section-start.json")
  string(JSON live_section_job GET "${reply}" job_id)
  file(WRITE "${TEST_DIR}/section-poll.json" "{\"action\":\"section\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\"}")
  # Publication briefly owns the workspace. Retry only this read-only poll,
  # only for its explicit busy result; never repeat a section admission.
  function(poll_section)
    foreach(read_attempt RANGE 0 199)
      execute_process(COMMAND "${CAD_EXE}" call cad_viewer --workspace "${TEST_DIR}/workspace" --input "${TEST_DIR}/section-poll.json"
        RESULT_VARIABLE read_status OUTPUT_VARIABLE read_output ERROR_VARIABLE read_logs TIMEOUT 30)
      if(read_status EQUAL 0)
        set(reply "${read_output}" PARENT_SCOPE)
        return()
      endif()
      string(JSON read_error ERROR_VARIABLE invalid_error GET "${read_logs}" error code)
      if(invalid_error OR NOT read_error STREQUAL "workspace_busy")
        message(FATAL_ERROR "Relocated section poll failed: ${read_logs}")
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.01)
    endforeach()
    message(FATAL_ERROR "Relocated section poll remained busy: ${read_logs}")
  endfunction()
  foreach(attempt RANGE 0 199)
    poll_section()
  string(JSON live_section_state GET "${reply}" state)
  if(NOT live_section_state STREQUAL "queued" AND NOT live_section_state STREQUAL "running" AND NOT live_section_state STREQUAL "cancelling")
    break()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.01)
endforeach()
if(NOT live_section_state STREQUAL "succeeded")
  message(FATAL_ERROR "Relocated live native section did not succeed: ${reply}")
endif()
string(JSON live_section_area GET "${reply}" result report area_mm2)
string(JSON live_section_result_job GET "${reply}" job_id)
if(NOT live_section_result_job STREQUAL live_section_job OR live_section_area LESS 117.8097 OR live_section_area GREATER 117.8098)
  message(FATAL_ERROR "Relocated live section lost its saved native job or analytic result")
endif()
call_tool(cad_context "${TEST_DIR}/presentation-read.json")
string(JSON restored_section_job GET "${reply}" section job_id)
if(NOT restored_section_job STREQUAL live_section_job)
  message(FATAL_ERROR "Relocated section did not survive reopening across native processes")
endif()
string(REPLACE "negative" "positive" reversed_section_presentation "${section_presentation}")
file(WRITE "${TEST_DIR}/section-reverse.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"presentation\":${reversed_section_presentation}}")
call_tool(cad_viewer "${TEST_DIR}/section-reverse.json")
string(JSON reversed_section_job GET "${reply}" section job_id)
if(NOT reversed_section_job STREQUAL live_section_job)
  message(FATAL_ERROR "Kept-side reversal retired the unchanged native section")
endif()
string(REPLACE "\"offset_mm\":8" "\"offset_mm\":9" moved_section_presentation "${section_presentation}")
file(WRITE "${TEST_DIR}/section-move.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"presentation\":${moved_section_presentation}}")
call_tool(cad_viewer "${TEST_DIR}/section-move.json")
poll_section()
string(JSON retired_section_state GET "${reply}" state)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" live_section_head_hash)
if(NOT retired_section_state STREQUAL "empty" OR NOT original_head_hash STREQUAL live_section_head_hash)
  message(FATAL_ERROR "Moving the section failed to retire derived geometry or changed source HEAD")
endif()
if(NOT EXISTS "${SOURCE_DIR}/APPEARANCE.md")
  message(FATAL_ERROR "Relocated bundle omitted appearance and saved-view guidance")
endif()
set(bundle_colors [=[{"default_color":[0.2,0.5,0.7],"parts":[{"part_id":"spacer_a","color":[0.9,0.2,0.1]}]}]=])
file(WRITE "${TEST_DIR}/colors.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"appearance\":${bundle_colors}}")
call_tool(cad_viewer "${TEST_DIR}/colors.json")
file(WRITE "${TEST_DIR}/preset-save.json" "{\"action\":\"preset\",\"operation\":\"save\",\"name\":\"Colored section\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\"}")
call_tool(cad_viewer "${TEST_DIR}/preset-save.json")
string(JSON preset_count LENGTH "${reply}" presets)
if(NOT preset_count EQUAL 1)
  message(FATAL_ERROR "Relocated native preset did not persist exactly one view")
endif()
file(WRITE "${TEST_DIR}/colors-reset.json" "{\"action\":\"context\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\",\"selection\":null,\"appearance\":{\"default_color\":[0.66,0.75,0.8],\"parts\":[]}}")
call_tool(cad_viewer "${TEST_DIR}/colors-reset.json")
file(WRITE "${TEST_DIR}/preset-apply.json" "{\"action\":\"preset\",\"operation\":\"apply\",\"name\":\"Colored section\",\"view_id\":\"bundle_presentation\",\"evaluation_id\":\"${presented_evaluation}\"}")
call_tool(cad_viewer "${TEST_DIR}/preset-apply.json")
string(JSON restored_color_owner GET "${reply}" appearance parts 0 part_id)
string(JSON restored_color_red GET "${reply}" appearance parts 0 color 0)
string(JSON restored_default_blue GET "${reply}" appearance default_color 2)
file(SHA256 "${TEST_DIR}/workspace/documents/${presented_document}/HEAD.json" colors_head_hash)
if(NOT restored_color_owner STREQUAL "spacer_a" OR NOT restored_color_red EQUAL 0.9 OR NOT restored_default_blue EQUAL 0.7 OR NOT original_head_hash STREQUAL colors_head_hash)
  message(FATAL_ERROR "Relocated native preset failed color restoration or changed source HEAD")
endif()
call_tool(cad_drawing "${SOURCE_DIR}/examples/assembly.drawing.json")
string(JSON assembly_artifacts LENGTH "${reply}" artifacts)
math(EXPR last_assembly_artifact "${assembly_artifacts}-1")
set(exploded_label FALSE)
foreach(index RANGE 0 ${last_assembly_artifact})
  string(JSON artifact_format GET "${reply}" artifacts ${index} format)
  if(artifact_format STREQUAL "svg")
    string(JSON artifact_file GET "${reply}" artifacts ${index} path)
    file(READ "${artifact_file}" assembly_svg)
    if(assembly_svg MATCHES "EXPLODED")
      set(exploded_label TRUE)
    endif()
  endif()
endforeach()
if(NOT exploded_label)
  message(FATAL_ERROR "Relocated exploded assembly drawing omitted its label")
endif()
# BOMs are generated from saved editable intent by the relocated service, with
# JSON/CSV usable independently of the application or developer tooling.
file(WRITE "${TEST_DIR}/bom.json" [=[{"document_id":"spacer_assembly","revision":1}]=])
call_tool(cad_bom "${TEST_DIR}/bom.json")
set(original_bom "${reply}")
string(JSON bom_quantity GET "${reply}" bom total_quantity)
string(JSON bom_items LENGTH "${reply}" bom items)
string(JSON plate_quantity GET "${reply}" bom items 0 quantity)
string(JSON spacer_quantity GET "${reply}" bom items 1 quantity)
string(JSON bom_files LENGTH "${reply}" artifacts)
if(NOT bom_quantity EQUAL 4 OR NOT bom_items EQUAL 2 OR NOT plate_quantity EQUAL 2 OR
   NOT spacer_quantity EQUAL 2 OR NOT bom_files EQUAL 2)
  message(FATAL_ERROR "Relocated BOM did not group repeated plate/spacer instances")
endif()
foreach(index RANGE 0 1)
  string(JSON artifact_file GET "${reply}" artifacts ${index} path)
  string(JSON artifact_bytes GET "${reply}" artifacts ${index} bytes)
  file(SIZE "${artifact_file}" actual_bytes)
  if(NOT actual_bytes EQUAL artifact_bytes OR actual_bytes LESS 1)
    message(FATAL_ERROR "Relocated BOM artifact does not match declared size")
  endif()
endforeach()
call_tool(cad_drawing "${SOURCE_DIR}/examples/assembly-bom.drawing.json")
string(JSON balloons LENGTH "${reply}" balloons)
string(JSON base_item GET "${reply}" balloons 0 item_number)
string(JSON spacer_item GET "${reply}" balloons 1 item_number)
string(JSON bom_artifacts LENGTH "${reply}" artifacts)
if(NOT balloons EQUAL 4 OR NOT base_item EQUAL 1 OR NOT spacer_item EQUAL 2 OR NOT bom_artifacts EQUAL 6)
  message(FATAL_ERROR "Relocated BOM drawing omitted source-matched balloons or sidecars")
endif()
set(found_bom_json FALSE)
set(found_bom_csv FALSE)
set(found_bom_table FALSE)
set(found_bom_balloons FALSE)
foreach(index RANGE 0 5)
  string(JSON artifact_format GET "${reply}" artifacts ${index} format)
  string(JSON artifact_file GET "${reply}" artifacts ${index} path)
  file(READ "${artifact_file}" artifact_content)
  if(artifact_format STREQUAL "json")
    string(JSON sidecar_quantity GET "${artifact_content}" bom total_quantity)
    string(JSON sidecar_revision GET "${artifact_content}" revision)
    if(NOT sidecar_quantity EQUAL 4 OR NOT sidecar_revision EQUAL 1)
      message(FATAL_ERROR "Relocated drawing BOM JSON lost its inventory or revision")
    endif()
    set(found_bom_json TRUE)
  elseif(artifact_format STREQUAL "csv")
    if(NOT artifact_content MATCHES "item_number" OR NOT artifact_content MATCHES "base;cover")
      message(FATAL_ERROR "Relocated drawing BOM CSV lost its grouped part identities")
    endif()
    set(found_bom_csv TRUE)
  elseif(artifact_format STREQUAL "svg")
    if(artifact_content MATCHES "BILL OF MATERIALS")
      set(found_bom_table TRUE)
    endif()
    if(artifact_content MATCHES "data-layer=\"BALLOONS\"")
      set(found_bom_balloons TRUE)
    endif()
  endif()
endforeach()
if(NOT found_bom_json OR NOT found_bom_csv OR NOT found_bom_table OR NOT found_bom_balloons)
  message(FATAL_ERROR "Relocated drawing omitted BOM sidecars, rendered table or numbered balloons")
endif()
file(WRITE "${TEST_DIR}/bom-edit.json" [=[{"document_id":"spacer_assembly","expected_revision":1,"operations":[{"op":"set_bom_item","assembly_id":"assembly","item":{"input":"plate","item_number":9,"description":"Plate, \"checked\""}}]}]=])
call_tool(cad_apply "${TEST_DIR}/bom-edit.json")
file(WRITE "${TEST_DIR}/bom-current.json" [=[{"document_id":"spacer_assembly","revision":2}]=])
call_tool(cad_bom "${TEST_DIR}/bom-current.json")
string(JSON edited_item GET "${reply}" bom items 1 item_number)
string(JSON edited_description GET "${reply}" bom items 1 description)
if(NOT edited_item EQUAL 9 OR NOT edited_description STREQUAL "Plate, \"checked\"")
  message(FATAL_ERROR "Relocated semantic BOM edit did not retain explicit metadata")
