# A bound joint edit changes the two assembly definitions, while retaining both
# imported solid entries. Inspect private cache evidence without a public API.
function(component_cache_entries prefix)
  file(GLOB paths "${TEST_DIR}/workspace/.cache/*.json")
  set(solids "")
  set(assemblies "")
  foreach(path IN LISTS paths)
    file(READ "${path}" envelope)
    string(JSON payload GET "${envelope}" payload)
    string(JSON feature ERROR_VARIABLE absent GET "${payload}" feature_id)
    if(NOT absent)
      if(feature MATCHES "^cf_12_hinge_module_")
        list(APPEND solids "${path}")
      elseif(feature STREQUAL "hinge_module" OR feature STREQUAL "fixture")
        list(APPEND assemblies "${path}")
      endif()
    endif()
  endforeach()
  list(SORT solids)
  list(LENGTH assemblies count)
  set(${prefix}_solids "${solids}" PARENT_SCOPE)
  set(${prefix}_assemblies "${count}" PARENT_SCOPE)
endfunction()
