# Exercise the relocated parser and read-only viewer with actual original
# bytes, while PATH and loader overrides remain empty. Fixtures are prebuilt
# developer inputs copied into this disposable workflow; no script runtime runs.
function(artifact_read_tool tool input)
  foreach(read_attempt RANGE 0 199)
    execute_process(COMMAND "${CAD_EXE}" call "${tool}" --workspace "${TEST_DIR}/workspace" --input "${input}"
      RESULT_VARIABLE read_status OUTPUT_VARIABLE read_output ERROR_VARIABLE read_logs TIMEOUT 30)
    if(read_status EQUAL 0)
      string(JSON read_kind TYPE "${read_output}")
      if(NOT read_kind STREQUAL "OBJECT")
        message(FATAL_ERROR "Relocated artifact read returned non-JSON stdout: ${read_output}")
      endif()
      set(reply "${read_output}" PARENT_SCOPE)
      return()
    endif()
    string(JSON read_error ERROR_VARIABLE invalid_error GET "${read_logs}" error code)
    if(invalid_error OR NOT read_error STREQUAL "workspace_busy")
      message(FATAL_ERROR "Relocated artifact ${tool} read failed: ${read_logs}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.01)
  endforeach()
  message(FATAL_ERROR "Relocated artifact ${tool} read remained busy: ${read_logs}")
endfunction()
