<robot name="motion"><material name="red"><color rgba="1 0 0 0.5"/></material><link name="base"/><link name="arm"><visual><origin xyz="1 0 0"/><geometry><box size="0.1 0.2 0.3"/></geometry><material name="red"/></visual></link><link name="finger"><visual><geometry><sphere radius="0.01"/></geometry></visual></link><joint name="hinge" type="revolute"><parent link="base"/><child link="arm"/><axis xyz="0 0 2"/><limit lower="-2" upper="2"/></joint><joint name="follower" type="revolute"><parent link="arm"/><child link="finger"/><origin xyz="2 0 0"/><axis xyz="0 0 1"/><limit lower="-4" upper="4"/><mimic joint="hinge" multiplier="2"/></joint></robot>