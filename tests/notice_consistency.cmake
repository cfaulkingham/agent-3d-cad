cmake_minimum_required(VERSION 3.24)
# Legal notices must agree with what the installer actually records. A stale
# modification identifier or archive hash in a shipped notice is a distribution
# defect, so fail the build instead of relying on a reviewer to notice.
if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR required")
endif()
function(read_text path out)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing required file: ${path}")
  endif()
  file(READ "${path}" text)
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

read_text("${SOURCE_DIR}/cmake/InstallBundle.cmake.in" installer)
string(REGEX MATCH "agentcad-hlr-midpoint-v[0-9]+" expected "${installer}")
if(NOT expected)
  message(FATAL_ERROR "Installer does not name an HLR modification identifier")
endif()
read_text("${SOURCE_DIR}/cmake/dependencies/CMakeLists.txt" recipe)

set(checks 0)
foreach(file IN ITEMS packaging/THIRD_PARTY.md cmake/dependencies/OCCT-HLR-PATCH.md)
  read_text("${SOURCE_DIR}/${file}" text)
  string(REGEX MATCHALL "agentcad-hlr-midpoint-v[0-9]+" ids "${text}")
  list(REMOVE_DUPLICATES ids)
  if(NOT ids STREQUAL expected)
    message(FATAL_ERROR "${file} names modification '${ids}', installer records '${expected}'")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()

read_text("${SOURCE_DIR}/packaging/THIRD_PARTY.md" notices)
string(REGEX MATCH "0d6913eae4bcc09a3653ceced6dda1aec11c35a1513d4c06762c9b002092c68a" shown "${notices}")
if(NOT shown OR NOT recipe MATCHES "${shown}")
  message(FATAL_ERROR "THIRD_PARTY.md must state the pinned OCCT archive SHA-256 used by the dependency recipe")
endif()
math(EXPR checks "${checks}+1")
foreach(phrase IN ITEMS "LGPL 2.1" "PatchOcctHlr.cmake" "occt/modified/" "relink")
  string(FIND "${notices}" "${phrase}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "THIRD_PARTY.md no longer mentions '${phrase}'")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()
foreach(file IN ITEMS NOTICE SECURITY.md CONTRIBUTING.md)
  read_text("${SOURCE_DIR}/${file}" text)
  math(EXPR checks "${checks}+1")
endforeach()
# The project's own code is MIT-licensed; NOTICE, LICENSE and the shipped
# third-party notice must agree, and the bundle must install them.
read_text("${SOURCE_DIR}/LICENSE" license)
if(NOT license MATCHES "^MIT License\n" OR NOT license MATCHES "Permission is hereby granted, free of charge")
  message(FATAL_ERROR "LICENSE must be the MIT License text")
endif()
read_text("${SOURCE_DIR}/NOTICE" project_notice)
string(FIND "${project_notice}" "licensed under the MIT License" at)
if(at EQUAL -1)
  message(FATAL_ERROR "NOTICE must state that the original code is MIT-licensed")
endif()
string(FIND "${notices}" "MIT-licensed" at)
if(at EQUAL -1)
  message(FATAL_ERROR "THIRD_PARTY.md must state that the original project code is MIT-licensed")
endif()
read_text("${SOURCE_DIR}/cmake/Bundle.cmake" bundle)
if(NOT bundle MATCHES "install\\(FILES LICENSE NOTICE packaging/THIRD_PARTY.md DESTINATION share/agent-3d-cad/notices\\)")
  message(FATAL_ERROR "The bundle must install LICENSE, NOTICE and THIRD_PARTY.md together")
endif()
# MIT covers only the original code. The OCCT exception and LGPL 2.1 section 6
# require prominent Open CASCADE notice in supporting documentation, and no
# distributable manifest may label the combined binary bundle as MIT-only.
read_text("${SOURCE_DIR}/README.md" readme)
foreach(phrase IN ITEMS "Open CASCADE Technology" "LGPL 2.1" "Open CASCADE exception")
  string(FIND "${readme}" "${phrase}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "README.md must prominently state that the engine uses Open CASCADE Technology under LGPL 2.1 with the Open CASCADE exception; missing '${phrase}'")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()
foreach(phrase IN ITEMS "not MIT-licensed as a whole" "corresponding source" "reverse-engineer")
  string(FIND "${project_notice}" "${phrase}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "NOTICE must separate the MIT grant from the combined bundle and state LGPL source/reverse-engineering rights; missing '${phrase}'")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()
foreach(phrase IN ITEMS "LGPL-2.1-only WITH OCCT-exception-1.0" "written offer" "reverse-engineer" "no GPLv2 election is made")
  string(FIND "${notices}" "${phrase}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "THIRD_PARTY.md must record the SPDX licence, the source written offer and LGPL rights; missing '${phrase}'")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()
read_text("${SOURCE_DIR}/plugins/agent-cad/plugin.json" plugin_manifest)
read_text("${SOURCE_DIR}/packaging/make-mcpb.py" mcpb_packager)
foreach(manifest IN ITEMS plugin_manifest mcpb_packager)
  string(FIND "${${manifest}}" "LGPL-2.1-only WITH OCCT-exception-1.0" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "Combined-bundle manifests must declare the LGPL-2.1/OCCT-exception component, not MIT alone (${manifest})")
  endif()
  math(EXPR checks "${checks}+1")
endforeach()
# LGPL relinking/replacement is satisfied by construction only with shared
# OCCT libraries; a portable bundle must refuse any other linkage.
string(FIND "${bundle}" "Portable bundles require shared Open CASCADE libraries" at)
if(at EQUAL -1)
  message(FATAL_ERROR "Bundle.cmake must reject non-shared OCCT linkage for portable bundles")
endif()
read_text("${SOURCE_DIR}/packaging/compose-macos-universal.py" universal)
string(FIND "${universal}" "'occt_linkage': 'SHARED_LIBRARY'" at)
if(at EQUAL -1)
  message(FATAL_ERROR "Universal composition must pin shared OCCT linkage")
endif()
read_text("${SOURCE_DIR}/packaging/bundle_validation.py" validator)
string(FIND "${validator}" "shared Open CASCADE libraries" at)
if(at EQUAL -1)
  message(FATAL_ERROR "Bundle validation must reject recorded non-shared OCCT linkage")
endif()
math(EXPR checks "${checks}+5")
message(STATUS "notice consistency checks passed: ${checks}")
